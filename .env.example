# Shared settings for Django and Docker. Generate independent SECRET_KEY and DB_PASSWORD values.
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# CSRF_TRUSTED_ORIGINS=https://school.example.org
# CORS_ALLOWED_ORIGINS=
# USE_X_FORWARDED_HOST=false
# TRUST_PROXY_SSL_HEADER=false
# Loopback HTTP. Set both true for HTTPS deployment.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# SECURE_SSL_REDIRECT=false
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# Select sqlite, mysql or postgres. Supply DB credentials for network databases.
DB_ENGINE=sqlite
# The Docker launcher uses PostgreSQL by default with this template.
DATABASE_ENGINE=postgres
# SQLITE_PATH=db.sqlite3
# Used by PostgreSQL in Docker.
DB_NAME=schoolstack
DB_USER=schoolstack
DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# DB_CONN_MAX_AGE=0
REDIS_URL=redis://127.0.0.1:6379/1
# STATIC_ROOT=../static_cdn
# MEDIA_URL=/media/
# MEDIA_ROOT=../media_cdn

# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=
# PASSWORD_RESET_TIMEOUT=86400

# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=mailto:admin@example.org
# WRITE_LOG_ON_FILE=true
# WRITE_LOG_ON_CONSOLE=true
# PERFORMANCE_LOG_ENABLED=true
# PERFORMANCE_QUERY_LOG_ENABLED defaults to DEBUG.
# PERFORMANCE_SLOW_REQUEST_MS=800
# PERFORMANCE_QUERY_WARNING_COUNT=50

# Listener. APP_PORT sets the container and published port unless HOST_PORT overrides it.
HOST_BIND=127.0.0.1
# HOST_PORT=8000
APP_PORT=8000


# Optional repository override. By default the launcher uses PROJECT_NAME.
# IMAGE_NAME=registry.example.org/schoolstackpro
# APP_IMAGE_TAG=local
# APP_IMAGE=schoolstackpro:reviewed-001  # Manual builds and direct Compose commands
# PYTHON_IMAGE=python:3.14-slim-bookworm
# UV_IMAGE=ghcr.io/astral-sh/uv:0.8.5
# Python package downloads during Docker builds
# UV_HTTP_TIMEOUT=180
# UV_HTTP_RETRIES=5
# UV_CONCURRENT_DOWNLOADS=4

# Shared VPS resource limits and Gunicorn settings.
WEB_WORKERS=1
WEB_TIMEOUT=120
# WEB_MAX_REQUESTS=2000
# WEB_MAX_REQUESTS_JITTER=200
# WEB_CPUS=1.0
WEB_MEMORY_LIMIT=1g
# POSTGRES_CPUS=1.0
# POSTGRES_MEMORY_LIMIT=1g

# Host bind mounts shared by the launcher and direct Compose commands.
PROJECT_NAME=schoolstackpro
DEPLOY_ENV=production
COMPOSE_PROJECT_NAME=schoolstackpro
VPS_STORAGE_ROOT=${HOME}/docker-apps
APP_DATA_ROOT=${VPS_STORAGE_ROOT}/${PROJECT_NAME}/${DEPLOY_ENV}
# URL prefix for uploaded files. Compose mounts MEDIA_DATA_DIR at /srv/media.
MEDIA_URL=/media/
MEDIA_DATA_DIR=${APP_DATA_ROOT}/media
DATA_DIR=${APP_DATA_ROOT}/data
POSTGRES_DATA_DIR=${APP_DATA_ROOT}/postgres

# Optional web push. The launcher mounts the existing PEM into web only.
# VAPID_KEY_FILE=${HOME}/docker-apps/schoolstackpro/secrets/private_key.pem
# VAPID_PUBLIC_KEY=<matching uncompressed P-256 point in URL-safe base64>
# To enable the VAPID mount for direct PostgreSQL Compose commands as well:
# COMPOSE_FILE=docker-compose.yml:docker-compose.vapid.yml
