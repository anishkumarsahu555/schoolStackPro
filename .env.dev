PASSWORD="dev-password"
SECRET_KEY="django-insecure-dev-only-change-me"
WRITE_LOG_ON_FILE=false
WRITE_LOG_ON_CONSOLE=true

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=private_key.pem
VAPID_ADMIN_EMAIL=mailto:admin@schoolsstack.local

# it can be postgres, mysql, or sqlite
db=postgres
DB_NAME=schoolsstack
DB_USER=postgres
DB_PASSWORD=pass
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0

PERFORMANCE_LOG_ENABLED=true
PERFORMANCE_QUERY_LOG_ENABLED=true
PERFORMANCE_SLOW_REQUEST_MS=800
PERFORMANCE_QUERY_WARNING_COUNT=50

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@schoolsstack.local
PASSWORD_RESET_TIMEOUT=3600
EMAIL_HOST=
