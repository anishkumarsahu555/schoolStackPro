# SchoolStack Docker settings. Generate separate SECRET_KEY and DB_PASSWORD
# values with openssl rand -hex 32 before the first launch.
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://school.example.org
# Local loopback HTTP. Set both true when serving via HTTPS.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Database and cache. Compose supplies DB_HOST=postgres, DB_PORT=5432 and
# REDIS_URL=redis://redis:6379/1 on its private network.
DB_ENGINE=postgres
DB_NAME=schoolstack
DB_USER=schoolstack
DB_PASSWORD=
# DATABASE_ENGINE=postgres
# DB_CONN_MAX_AGE=0

# Listener. APP_PORT sets the container and published port unless HOST_PORT overrides it.
HOST_BIND=127.0.0.1
# HOST_PORT=8000
APP_PORT=8000


# Application build and release image. Omit APP_IMAGE to generate a unique release tag on --docker-up.
# IMAGE_NAME=schoolstackpro-web
# APP_IMAGE_TAG=local
APP_IMAGE=schoolstackpro-web:local
# PYTHON_IMAGE=python:3.14-slim-bookworm
# UV_IMAGE=ghcr.io/astral-sh/uv:0.8.5

# Shared VPS resource limits and Gunicorn settings.
WEB_WORKERS=1
WEB_TIMEOUT=120
# WEB_MAX_REQUESTS=2000
# WEB_MAX_REQUESTS_JITTER=200
# WEB_CPUS=1.0
WEB_MEMORY_LIMIT=1g
# POSTGRES_CPUS=1.0
# POSTGRES_MEMORY_LIMIT=1g

# Host bind mounts shared by the launcher and direct Compose commands.
PROJECT_NAME=schoolstackpro
DEPLOY_ENV=production
COMPOSE_PROJECT_NAME=schoolstackpro
VPS_STORAGE_ROOT=${HOME}/docker-apps
APP_DATA_ROOT=${VPS_STORAGE_ROOT}/${PROJECT_NAME}/${DEPLOY_ENV}
MEDIA_DATA_DIR=${APP_DATA_ROOT}/media
DATA_DIR=${APP_DATA_ROOT}/data
POSTGRES_DATA_DIR=${APP_DATA_ROOT}/postgres
